{
  "name": "@flycommerce/ui",
  "version": "0.1.0",
  "private": true,
  "description": "FlyCommerce design system: React components built on shadcn/ui and Radix.",
  "license": "MIT",
  "keywords": [
    "flycommerce",
    "design-system",
    "react",
    "shadcn",
    "radix",
    "tailwindcss",
    "components"
  ],
  "homepage": "https://github.com/getdokan/flycommerce-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdokan/flycommerce-ui.git"
  },
  "bugs": {
    "url": "https://github.com/getdokan/flycommerce-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./theme.css": "./dist/styles/theme.css",
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    }
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && pnpm build:css",
    "build:css": "mkdir -p dist/styles && cp src/styles/components.css src/styles/theme.css src/styles/tailwind.css src/styles/fonts.css dist/styles/ && tailwindcss -i src/styles/standalone.css -o dist/styles.css --minify",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css}\"",
    "build:site": "vite build --config playground/vite.config.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-dts": "^5.1.1"
  },
  "packageManager": "pnpm@10.33.0"
}
