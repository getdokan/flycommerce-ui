{
  "name": "@flycommerce/ui",
  "version": "0.2.0",
  "description": "FlyCommerce design system for React: accessible components, design tokens and commerce patterns built on shadcn/ui, Radix and Tailwind CSS.",
  "license": "MIT",
  "author": "FlyCommerce",
  "keywords": [
    "flycommerce",
    "design-system",
    "react",
    "shadcn",
    "radix",
    "tailwindcss",
    "components",
    "ui",
    "ecommerce",
    "accessible",
    "tailwind"
  ],
  "homepage": "https://ui.flycommerce.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdokan/flycommerce-ui.git"
  },
  "bugs": {
    "url": "https://github.com/getdokan/flycommerce-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./tailwind-core.css": "./dist/styles/tailwind-core.css",
    "./theme.css": "./dist/styles/theme.css",
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    }
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && node scripts/fix-dts-extensions.mjs && pnpm build:css",
    "build:css": "mkdir -p dist/styles && cp src/styles/components.css src/styles/base.css src/styles/theme.css src/styles/tailwind.css src/styles/tailwind-core.css src/styles/fonts.css dist/styles/ && tailwindcss -i src/styles/standalone.css -o dist/styles.css --minify",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints tailwind.css tailwind-core.css theme.css styles.css fonts.css",
    "format": "prettier --write \"**/*.{ts,tsx,css}\"",
    "build:site": "vite build --config playground/vite.config.ts",
    "skill:refs": "node scripts/skill-refs.mjs && prettier --write plugin/skills/flycommerce-ui/references --log-level warn"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.14.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "axe-core": "^4.13.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "sugar-high": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
